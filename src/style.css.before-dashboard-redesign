
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', Arial, sans-serif;
  color: #202b40;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

* { box-sizing: border-box; }

body { margin: 0; min-width: 320px; min-height: 100vh; }
button { font: inherit; cursor: pointer; }
button:focus-visible { outline: 2px solid #3979ef; outline-offset: 2px; }

.app-shell { min-height: 100vh; }
.sidebar {
  width: 252px;
  position: fixed;
  inset: 0 auto 0 0;
  background: #fff;
  border-right: 1px solid #e9edf4;
  padding: 27px 17px 15px;
  display: flex;
  flex-direction: column;
  z-index: 10;
}
.brand { display: flex; align-items: center; gap: 12px; padding: 0 9px 34px; }
.brand-icon {
  width: 43px; height: 43px; border-radius: 13px;
  background: #175bd5; color: white;
  display: grid; place-items: center;
}
.brand h2 { margin: 0; font: 800 20px 'Manrope', sans-serif; letter-spacing: -.7px; color: #18263d; }
.brand p { margin: 4px 0 0; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; color: #8c98aa; }
.menu-heading { font-size: 10px; font-weight: 700; letter-spacing: 1.3px; color: #9ba5b5; padding: 0 12px 12px; }
.nav-item {
  display: flex; align-items: center; gap: 12px;
  width: 100%; padding: 12px 13px; margin: 3px 0;
  border: 0; border-radius: 9px; background: transparent;
  color: #69768b; text-align: left; font-size: 13px; font-weight: 600;
}
.nav-item span { flex: 1; }
.nav-item:hover { background: #f5f7fb; }
.nav-item.active { background: #eaf1ff; color: #175bd5; }
.sidebar-bottom { margin-top: auto; }
.secure-badge { display: flex; gap: 10px; padding: 14px 10px; background: #f5f8ff; border-radius: 10px; color: #3571dc; }
.secure-badge strong, .profile strong { display: block; font-size: 11px; color: #34425a; }
.secure-badge p, .profile p { margin: 4px 0 0; font-size: 10px; color: #8b97a9; }
.profile { display: flex; align-items: center; gap: 10px; border-top: 1px solid #edf0f5; margin-top: 17px; padding: 18px 5px 3px; }
.avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #dce9ff; color: #1c5ac1; font-weight: 800; }

.main-area { margin-left: 252px; min-height: 100vh; }
.topbar {
  height: 70px; display: flex; align-items: center; justify-content: space-between;
  background: white; border-bottom: 1px solid #e9edf4; padding: 0 34px;
}
.breadcrumb { font-size: 12px; color: #7e8a9d; }
.breadcrumb span { padding: 0 9px; color: #c2c9d4; }
.top-actions { display: flex; align-items: center; gap: 18px; }
.preview-label { color: #9b6c16; background: #fff5dc; padding: 6px 9px; border-radius: 5px; font-size: 9px; font-weight: 800; letter-spacing: .7px; }
.icon-button, .mobile-menu { border: 0; background: transparent; color: #68758a; display: grid; place-items: center; }
.mobile-menu { display: none; }
.page-content { max-width: 1450px; padding: 35px 34px 24px; margin: auto; }
.welcome-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 28px; }
.eyebrow { color: #3271df; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; margin: 0 0 10px; }
h1 { font: 800 clamp(23px, 2.3vw, 30px) 'Manrope', sans-serif; letter-spacing: -.9px; margin: 0; color: #18263d; }
.subtitle { color: #8792a4; font-size: 12px; margin: 10px 0 0; line-height: 1.6; }
.primary-button, .secondary-button {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  border-radius: 8px; padding: 11px 15px; font-size: 12px; font-weight: 700; white-space: nowrap;
}
.primary-button { border: 1px solid #175bd5; background: #175bd5; color: white; box-shadow: 0 4px 9px #175bd51c; }
.primary-button:hover { background: #104bb7; }
.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 22px; }
.stat-card, .panel { background: white; border: 1px solid #e9edf4; border-radius: 12px; }
.stat-card { padding: 19px; }
.stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #7f8a9c; font-size: 11px; font-weight: 600; }
.stat-icon { width: 37px; height: 37px; border-radius: 10px; display: grid; place-items: center; color: #2d6dd7; background: #edf3ff; flex-shrink: 0; }
.stat-card h2 { font: 800 27px 'Manrope', sans-serif; margin: 17px 0 5px; letter-spacing: -.8px; color: #1e2b42; }
.stat-card p { margin: 0; font-size: 10px; color: #9aa4b4; }
.content-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; }
.panel { padding: 22px; min-width: 0; }
.panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.panel-heading h3 { font: 800 15px 'Manrope', sans-serif; margin: 0; color: #26334a; }
.panel-heading p { margin: 6px 0 0; color: #96a0b0; font-size: 11px; }
.text-button { display: inline-flex; align-items: center; gap: 3px; background: transparent; border: 0; color: #2868d4; font-size: 11px; font-weight: 700; white-space: nowrap; }
.empty-state { padding: 34px 14px 25px; text-align: center; }
.empty-icon { margin: auto; width: 54px; height: 54px; border-radius: 15px; background: #f1f5fc; color: #6c88bb; display: grid; place-items: center; }
.empty-state h3 { margin: 16px 0 7px; font-size: 13px; color: #39465b; }
.empty-state p { max-width: 275px; margin: 0 auto 17px; font-size: 11px; line-height: 1.7; color: #929daf; }
.secondary-button { background: white; border: 1px solid #dfe6f0; color: #42516a; padding: 9px 12px; }
.secondary-button:hover { background: #f7f9fc; }
.quick-list { margin-top: 15px; }
.quick-list button { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 13px 0; background: transparent; border: 0; border-bottom: 1px solid #eff2f6; color: #8995a7; }
.quick-list button:last-child { border-bottom: 0; }
.quick-list button > span:nth-child(2) { flex: 1; }
.quick-icon { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: #f0f5ff; color: #3974d8; }
.quick-list strong { display: block; font-size: 11px; color: #344158; }
.quick-list small { display: block; margin-top: 5px; color: #96a0b0; font-size: 10px; }
.quick-list button:hover strong { color: #175bd5; }
.bottom-note { display: flex; gap: 12px; align-items: flex-start; margin-top: 20px; padding: 16px; background: #edf4ff; color: #3670cf; border: 1px solid #e1ebff; border-radius: 10px; }
.bottom-note p { margin: 0; font-size: 11px; color: #637a9e; line-height: 1.7; }
.bottom-note strong { color: #2a5597; }
footer { text-align: center; font-size: 10px; color: #a1aaba; padding: 24px 0 4px; }

@media (max-width: 1100px) {
  .sidebar { width: 220px; }
  .main-area { margin-left: 220px; }
  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .page-content { padding: 28px 22px; }
  .topbar { padding: 0 22px; }
}
@media (max-width: 700px) {
  .sidebar { transform: translateX(-100%); transition: transform .2s ease; box-shadow: 8px 0 30px #17243a12; }
  .sidebar.sidebar-open { transform: translateX(0); }
  .main-area { margin-left: 0; }
  .topbar { height: 60px; padding: 0 15px; gap: 12px; }
  .mobile-menu { display: grid; }
  .breadcrumb { flex: 1; }
  .top-actions { gap: 10px; }
  .preview-label { font-size: 8px; }
  .page-content { padding: 25px 15px; }
  .welcome-row { align-items: flex-start; flex-direction: column; }
  .primary-button { width: 100%; }
  .stats-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .stat-card { padding: 13px; }
  .stat-top { align-items: flex-start; font-size: 10px; }
  .stat-icon { width: 31px; height: 31px; }
  .stat-card h2 { font-size: 23px; margin-top: 14px; }
  .content-grid { grid-template-columns: 1fr; }
  .panel { padding: 17px; }
}
@media (max-width: 370px) {
  .stats-grid { grid-template-columns: 1fr; }
}

/* ===== LIC SAATHI AUTH DESIGN ===== */

.auth-page {
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
  background: #f5f7fb;
  color: #17243a;
  font-family: "DM Sans", Arial, sans-serif;
}

.auth-brand-panel {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: clamp(32px, 5vw, 76px);
  color: #fff;
  background: linear-gradient(145deg, #101d35 0%, #173b66 100%);
}

.auth-brand-panel::before,
.auth-brand-panel::after {
  content: "";
  position: absolute;
  border: 1px solid rgba(216, 182, 106, 0.19);
  border-radius: 50%;
  pointer-events: none;
}

.auth-brand-panel::before {
  width: 440px;
  height: 440px;
  right: -180px;
  top: 12%;
}

.auth-brand-panel::after {
  width: 300px;
  height: 300px;
  right: -100px;
  top: 23%;
}

.auth-brand-content,
.auth-brand-footer,
.auth-brand-top {
  position: relative;
  z-index: 1;
}

.auth-brand-top {
  display: flex;
  align-items: center;
  gap: 13px;
}

.auth-brand-mark {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 14px;
  color: #142440;
  background: #d8b66a;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -1px;
}

.auth-brand-name {
  margin: 0;
  color: #fff;
  font-family: "Manrope", sans-serif;
  font-size: 22px;
  font-weight: 800;
}

.auth-brand-eyebrow {
  margin: 4px 0 0;
  color: #d8b66a;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.auth-brand-content {
  max-width: 560px;
  margin: 70px 0;
}

.auth-brand-content h2 {
  margin: 0 0 20px;
  color: #fff;
  font-family: "Manrope", sans-serif;
  font-size: clamp(34px, 4vw, 56px);
  line-height: 1.16;
  letter-spacing: -1.8px;
}

.auth-brand-content > p {
  max-width: 440px;
  color: #c8d4e4;
  font-size: 16px;
  line-height: 1.9;
}

.auth-benefits {
  display: grid;
  gap: 16px;
  margin-top: 36px;
}

.auth-benefit {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #e8edf5;
  font-size: 14px;
}

.auth-benefit-icon {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 1px solid rgba(216, 182, 106, 0.45);
  border-radius: 9px;
  color: #e5c77f;
}

.auth-brand-footer {
  color: #9eafc6;
  font-size: 12px;
  line-height: 1.8;
}

.auth-form-panel {
  display: grid;
  place-items: center;
  padding: 36px clamp(24px, 5vw, 80px);
  background: #fff;
}

.auth-card {
  width: 100%;
  max-width: 420px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.auth-card h1 {
  margin: 0 0 10px;
  color: #17243a;
  font-family: "Manrope", sans-serif;
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -1px;
}

.auth-logo {
  display: none;
}

.auth-subtitle {
  margin: 0 0 30px;
  color: #69778b;
  font-size: 14px;
  line-height: 1.7;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  padding: 5px;
  margin-bottom: 28px;
  border-radius: 12px;
  background: #f0f3f8;
}

.auth-tabs button {
  min-height: 43px;
  border: 0;
  border-radius: 9px;
  color: #657187;
  background: transparent;
  font-size: 14px;
  font-weight: 600;
  transition: background 0.2s, color 0.2s, box-shadow 0.2s;
}

.auth-tabs button.active {
  color: #17345b;
  background: #fff;
  box-shadow: 0 2px 8px rgba(20, 40, 70, 0.08);
}

.auth-form {
  display: grid;
  gap: 20px;
}

.auth-form label {
  display: grid;
  gap: 9px;
  color: #344054;
  font-size: 13px;
  font-weight: 600;
}

.auth-form input {
  width: 100%;
  min-width: 0;
  min-height: 49px;
  padding: 0 15px;
  border: 1px solid #d9e0e9;
  border-radius: 10px;
  outline: none;
  color: #17243a;
  background: #fff;
  font: inherit;
  font-size: 14px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.auth-form input::placeholder {
  color: #a0aaba;
}

.auth-form input:focus {
  border-color: #315f96;
  box-shadow: 0 0 0 4px rgba(49, 95, 150, 0.11);
}

.auth-submit {
  min-height: 50px;
  margin-top: 3px;
  border: 0;
  border-radius: 10px;
  color: #fff;
  background: #17345b;
  box-shadow: 0 5px 12px rgba(23, 52, 91, 0.14);
  font-size: 14px;
  font-weight: 700;
  transition: background 0.2s, transform 0.2s;
}

.auth-submit:hover:not(:disabled) {
  background: #214979;
  transform: translateY(-1px);
}

.auth-submit:disabled {
  cursor: wait;
  opacity: 0.65;
}

.auth-message {
  margin: 0;
  padding: 12px 14px;
  border: 1px solid #dbe5f1;
  border-radius: 9px;
  color: #25476e;
  background: #f3f7fc;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.auth-footer {
  margin: 26px 0 0;
  color: #8994a5;
  font-size: 11px;
  line-height: 1.8;
  text-align: center;
}

.auth-logout {
  position: fixed;
  top: 12px;
  right: 16px;
  z-index: 50;
  padding: 9px 14px;
  border: 1px solid #d9e0e9;
  border-radius: 9px;
  color: #17345b;
  background: #fff;
  font-size: 13px;
  font-weight: 600;
}

.auth-loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  color: #17345b;
  background: #f5f7fb;
  font-weight: 600;
}

@media (max-width: 900px) {
  .auth-page {
    grid-template-columns: 1fr;
  }

  .auth-brand-panel {
    min-height: auto;
    padding: 28px 26px;
  }

  .auth-brand-content {
    margin: 42px 0 22px;
  }

  .auth-brand-content h2 {
    max-width: 520px;
    font-size: 36px;
  }

  .auth-brand-content > p {
    font-size: 14px;
  }

  .auth-benefits {
    gap: 11px;
    margin-top: 22px;
  }

  .auth-brand-footer {
    margin-top: 15px;
  }

  .auth-form-panel {
    padding: 40px 24px 52px;
  }
}

@media (max-width: 480px) {
  .auth-brand-panel {
    padding: 24px 20px;
  }

  .auth-brand-content {
    margin: 32px 0 18px;
  }

  .auth-brand-content h2 {
    font-size: 31px;
    letter-spacing: -0.8px;
  }

  .auth-form-panel {
    padding: 34px 22px 42px;
  }

  .auth-card h1 {
    font-size: 28px;
  }
}

/* ===== LIC Saathi: Professional Customers UI ===== */

.customer-page {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  color: #172b4d;
}

.customer-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  margin-bottom: 26px;
}

.customer-toolbar h2 {
  margin: 0 0 8px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 800;
  letter-spacing: -0.8px;
  color: #142544;
}

.customer-toolbar p {
  margin: 0;
  color: #718096;
  font-size: 14px;
}

.customer-page .primary-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 19px;
  border: 1px solid #215be8;
  border-radius: 10px;
  background: #2563eb;
  color: #fff;
  font-weight: 700;
  font-size: 14px;
  box-shadow: 0 5px 12px rgba(37, 99, 235, 0.15);
  transition: background .2s, transform .2s, box-shadow .2s;
}

.customer-page .primary-button:hover {
  background: #194fce;
  box-shadow: 0 7px 16px rgba(37, 99, 235, .22);
  transform: translateY(-1px);
}

.customer-page .primary-button:disabled {
  opacity: .65;
  cursor: wait;
  transform: none;
}

.customer-message {
  padding: 14px 16px;
  margin: 0 0 20px;
  border: 1px solid #dbeafe;
  border-radius: 10px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 14px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.customer-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  padding: 25px;
  margin-bottom: 24px;
  border: 1px solid #e5eaf2;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 5px 24px rgba(24, 44, 80, .045);
}

.customer-form label {
  display: flex;
  flex-direction: column;
  gap: 9px;
  min-width: 0;
  color: #344563;
  font-size: 13px;
  font-weight: 700;
}

.customer-form input,
.customer-form textarea {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 46px;
  padding: 12px 14px;
  border: 1px solid #dce3ed;
  border-radius: 9px;
  outline: none;
  background: #fbfcfe;
  color: #172b4d;
  font: inherit;
  font-size: 14px;
  font-weight: 400;
  transition: border-color .2s, box-shadow .2s, background .2s;
}

.customer-form textarea {
  min-height: 90px;
  resize: vertical;
  line-height: 1.5;
}

.customer-form input::placeholder,
.customer-form textarea::placeholder,
.customer-search input::placeholder {
  color: #9aa8bc;
}

.customer-form input:focus,
.customer-form textarea:focus,
.customer-search:focus-within {
  border-color: #6090ff;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
}

.customer-form > button[type="submit"] {
  justify-self: start;
}

.customer-search {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 50px;
  padding: 0 16px;
  margin-bottom: 22px;
  border: 1px solid #e1e7f0;
  border-radius: 11px;
  background: #fff;
  color: #718096;
  transition: border-color .2s, box-shadow .2s;
}

.customer-search input {
  width: 100%;
  min-width: 0;
  height: 48px;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #172b4d;
  font: inherit;
  font-size: 14px;
  box-shadow: none;
}

.customer-search input:focus {
  outline: none;
  box-shadow: none;
}

.customer-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 250px;
  padding: 36px 20px;
  border: 1px dashed #d7e0ed;
  border-radius: 16px;
  background: rgba(255, 255, 255, .75);
  text-align: center;
  color: #718096;
}

.customer-empty > svg {
  box-sizing: content-box;
  padding: 17px;
  border-radius: 15px;
  background: #edf4ff;
  color: #2563eb;
}

.customer-empty h3 {
  margin: 18px 0 7px;
  color: #203454;
  font-size: 18px;
}

.customer-empty p {
  max-width: 380px;
  margin: 0;
  font-size: 14px;
  line-height: 1.7;
}

.customer-list {
  display: grid;
  gap: 12px;
}

.customer-card {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 0;
  padding: 19px;
  border: 1px solid #e5eaf2;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(24, 44, 80, .035);
  transition: border-color .2s, box-shadow .2s;
}

.customer-card:hover {
  border-color: #c7d8ff;
  box-shadow: 0 7px 20px rgba(24, 44, 80, .07);
}

.customer-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 49px;
  height: 49px;
  border: 1px solid #dbeafe;
  border-radius: 14px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20px;
  font-weight: 800;
}

.customer-details {
  flex: 1;
  min-width: 0;
}

.customer-details h3 {
  margin: 0 0 7px;
  color: #1c2e4a;
  font-size: 16px;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.customer-details p {
  margin: 4px 0 0;
  color: #718096;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.customer-delete {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid #fee2e2;
  border-radius: 10px;
  background: #fff7f7;
  color: #dc2626;
  transition: background .2s, border-color .2s;
}

.customer-delete:hover {
  border-color: #fecaca;
  background: #fee2e2;
}

.customer-count {
  margin: 20px 0 0;
  color: #718096;
  font-size: 13px;
}

@media (max-width: 650px) {
  .customer-toolbar {
    align-items: flex-start;
  }

  .customer-toolbar .primary-button {
    width: 100%;
  }

  .customer-form {
    grid-template-columns: minmax(0, 1fr);
    gap: 17px;
    padding: 18px;
  }

  .customer-form > button[type="submit"] {
    width: 100%;
  }

  .customer-card {
    gap: 11px;
    padding: 14px;
  }

  .customer-avatar {
    width: 42px;
    height: 42px;
  }
}

/* ===== LIC SAATHI: PROFESSIONAL POLICIES PAGE ===== */

.policies-page {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 8px 4px 32px;
  color: #172b4d;
  font-family: inherit;
}

.policies-page * {
  box-sizing: border-box;
}

.policies-page .policies-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.policies-page .policies-heading h1 {
  margin: 0 0 8px;
  font-size: clamp(25px, 3vw, 32px);
  line-height: 1.25;
  font-weight: 750;
  letter-spacing: -0.8px;
  color: #142747;
}

.policies-page .policies-heading p {
  margin: 0;
  color: #718096;
  font-size: 14px;
  line-height: 1.7;
}

.policies-page .policies-count {
  min-width: 155px;
  padding: 17px 22px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  border: 1px solid #dce7f8;
  border-radius: 15px;
  background: linear-gradient(135deg, #ffffff, #edf4ff);
  box-shadow: 0 4px 14px rgba(31, 65, 114, 0.05);
}

.policies-page .policies-count strong {
  font-size: 30px;
  line-height: 1.2;
  color: #245bd6;
}

.policies-page .policies-count span {
  color: #64748b;
  font-size: 12px;
  font-weight: 600;
}

.policies-page .policy-form-card,
.policies-page .policy-list-card {
  min-width: 0;
  margin-bottom: 24px;
  padding: 26px;
  border: 1px solid #e5eaf2;
  border-radius: 17px;
  background: #ffffff;
  box-shadow: 0 5px 22px rgba(28, 48, 82, 0.045);
}

.policies-page .policy-form-card h2,
.policies-page .policy-list-card h2 {
  margin: 0;
  color: #1b2e4b;
  font-size: 19px;
  font-weight: 700;
}

.policies-page .policy-form-card > h2 {
  margin-bottom: 22px;
}

.policies-page .policy-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 21px 24px;
  align-items: start;
}

.policies-page .policy-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  color: #34445e;
  font-size: 13px;
  font-weight: 650;
}

.policies-page .policy-form input,
.policies-page .policy-form select,
.policies-page .policy-form textarea,
.policies-page .policy-list-heading input {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 45px;
  margin: 0;
  padding: 11px 13px;
  border: 1px solid #d9e1ed;
  border-radius: 9px;
  outline: none;
  background: #ffffff;
  color: #243650;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.policies-page .policy-form textarea {
  min-height: 95px;
  resize: vertical;
}

.policies-page .policy-form input::placeholder,
.policies-page .policy-list-heading input::placeholder {
  color: #9aa8ba;
}

.policies-page .policy-form input:focus,
.policies-page .policy-form select:focus,
.policies-page .policy-form textarea:focus,
.policies-page .policy-list-heading input:focus {
  border-color: #4779ed;
  box-shadow: 0 0 0 3px rgba(71, 121, 237, 0.12);
}

.policies-page .policy-form .policy-notes-field {
  grid-column: 1 / -1;
}

.policies-page .policy-form > button[type="submit"] {
  min-height: 46px;
  justify-self: start;
  align-self: center;
  padding: 0 25px;
  border: none;
  border-radius: 9px;
  background: #245bd6;
  color: #ffffff;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 5px 12px rgba(36, 91, 214, 0.16);
  transition: background 0.18s ease, transform 0.18s ease;
}

.policies-page .policy-form > button[type="submit"]:hover {
  background: #1748b6;
  transform: translateY(-1px);
}

.policies-page .policy-form > button[type="submit"]:disabled {
  opacity: 0.65;
  cursor: wait;
  transform: none;
}

.policies-page .policy-message {
  margin: 0 0 20px;
  padding: 13px 16px;
  border: 1px solid #cfe0fb;
  border-radius: 10px;
  background: #f0f6ff;
  color: #244b8f;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.policies-page .policy-list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 22px;
}

.policies-page .policy-list-heading input {
  max-width: 310px;
}

.policies-page .policy-table-wrap {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #e6ebf3;
  border-radius: 11px;
}

.policies-page .policy-table {
  width: 100%;
  min-width: 850px;
  border-collapse: separate;
  border-spacing: 0;
  background: #ffffff;
  font-size: 13px;
  text-align: left;
}

.policies-page .policy-table th {
  padding: 15px 16px;
  background: #f5f8fd;
  border-bottom: 1px solid #e2e8f1;
  color: #60718a;
  font-size: 11px;
  font-weight: 750;
  letter-spacing: 0.45px;
  text-transform: uppercase;
  white-space: nowrap;
}

.policies-page .policy-table td {
  padding: 16px;
  border-bottom: 1px solid #edf0f5;
  color: #34445e;
  vertical-align: middle;
}

.policies-page .policy-table tbody tr:last-child td {
  border-bottom: none;
}

.policies-page .policy-table tbody tr:hover {
  background: #f8faff;
}

.policies-page .policy-table td:first-child {
  color: #1d3558;
  font-weight: 650;
}

.policies-page .policy-status {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  border: 1px solid #bfe8d0;
  border-radius: 20px;
  background: #eafaf1;
  color: #18794e;
  font-size: 11px;
  font-weight: 700;
  text-transform: capitalize;
  white-space: nowrap;
}

.policies-page .policy-delete-button {
  padding: 7px 12px;
  border: 1px solid #f1caca;
  border-radius: 7px;
  background: #fff6f6;
  color: #c33c3c;
  font-family: inherit;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}

.policies-page .policy-delete-button:hover {
  background: #ffe8e8;
}

.policies-page .policy-list-card > p,
.policies-page .policy-form-card > p {
  margin: 18px 0 4px;
  color: #77869b;
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 900px) {
  .policies-page .policy-form-card,
  .policies-page .policy-list-card {
    padding: 20px;
  }

  .policies-page .policy-form {
    gap: 18px;
  }
}

@media (max-width: 600px) {
  .policies-page {
    padding: 4px 0 22px;
  }

  .policies-page .policies-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }

  .policies-page .policies-count {
    width: 100%;
    min-width: 0;
    padding: 14px 17px;
  }

  .policies-page .policies-count strong {
    font-size: 25px;
  }

  .policies-page .policy-form-card,
  .policies-page .policy-list-card {
    padding: 17px;
    border-radius: 13px;
  }

  .policies-page .policy-form {
    grid-template-columns: minmax(0, 1fr);
    gap: 17px;
  }

  .policies-page .policy-form .policy-notes-field {
    grid-column: auto;
  }

  .policies-page .policy-form > button[type="submit"] {
    width: 100%;
    justify-self: stretch;
  }

  .policies-page .policy-list-heading {
    align-items: stretch;
    flex-direction: column;
    gap: 13px;
  }

  .policies-page .policy-list-heading input {
    max-width: none;
  }
}
